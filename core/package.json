{
  "name": "lypora-core",
  "private": true,
  "version": "0.4.0",
  "type": "module",
  "description": "Lypora: cross-platform live-preview Markdown editor core",
  "scripts": {
    "dev": "node scripts/gen-katex-css.mjs && vite",
    "build": "node scripts/gen-katex-css.mjs && vite build",
    "typecheck": "node scripts/gen-katex-css.mjs && tsc --noEmit",
    "preview": "vite preview --host 127.0.0.1 --port 4173"
  },
  "dependencies": {
    "@capacitor/core": "^7.6.10",
    "@capacitor/filesystem": "^7.1.9",
    "@capacitor/share": "^7.0.4",
    "@codemirror/commands": "^6.9.0",
    "@codemirror/lang-css": "^6.3.1",
    "@codemirror/lang-javascript": "^6.2.5",
    "@codemirror/lang-markdown": "^6.5.2",
    "@codemirror/language": "^6.11.3",
    "@codemirror/search": "^6.5.11",
    "@codemirror/state": "^6.5.2",
    "@codemirror/view": "^6.43.15",
    "@lezer/common": "^1.2.3",
    "@lezer/highlight": "^1.2.1",
    "@lezer/markdown": "^1.8.1",
    "katex": "^0.16.25"
  },
  "devDependencies": {
    "@capacitor/android": "^7.6.10",
    "@capacitor/cli": "^7.6.10",
    "playwright-core": "^1.64.1",
    "typescript": "^7.0.2",
    "vite": "^8.3.5"
  },
  "license": "MIT",
  "author": "dr-bing-li",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dr-bing-li/lypora.git"
  },
  "homepage": "https://github.com/dr-bing-li/lypora#readme",
  "bugs": {
    "url": "https://github.com/dr-bing-li/lypora/issues"
  }
}
