{
  "appId": "app.lypora.editor",
  "appName": "Lypora",
  "webDir": "dist",
  "android": {
    "minSdkVersion": 29,
    "targetSdkVersion": 35,
    "compileSdkVersion": 35,
    "allowMixedContent": false,
    "captureInput": true,
    "webContentsDebuggingEnabled": false
  },
  "server": {
    "androidScheme": "https"
  },
  "plugins": {
    "SplashScreen": {
      "launchAutoHide": true,
      "backgroundColor": "#ffffff"
    }
  }
}
